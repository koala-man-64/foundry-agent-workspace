<Project Sdk="Microsoft.NET.Sdk">
  <!-- Win32 primitives (JobProcess, FinalPath, ProtectedDirectory, ProtectedSecret). The only project that may enable unsafe code. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Foundry.Platform.Tests" />
    <!-- DriveAdmissions.Fake: the runtime suites place fixtures on removable, optical or network "drives". -->
    <InternalsVisibleTo Include="Foundry.Conformance" />
  </ItemGroup>

  <ItemGroup>
    <!-- Electron 44's Unicode 17.0 lowercase tables for path_key; tests/golden/ecmascript-case.test.ts regenerates them. -->
    <EmbeddedResource Include="EcmaScriptLowercase.json" LogicalName="Foundry.Platform.EcmaScriptLowercase.json" />
  </ItemGroup>
</Project>
