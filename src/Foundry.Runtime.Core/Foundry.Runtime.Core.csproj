<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The runtime library. Foundry.Runtime (the exe) owns the assembly name Foundry.Runtime. -->
    <RootNamespace>Foundry.Runtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundry.Protocol\Foundry.Protocol.csproj" />
    <ProjectReference Include="..\Foundry.Providers\Foundry.Providers.csproj" />
    <ProjectReference Include="..\Foundry.Platform\Foundry.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Enforces the single-thread RuntimeLoop model; see BannedSymbols.txt. The analyzer comes from src/Directory.Build.props. -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
</Project>
