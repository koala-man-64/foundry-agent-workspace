<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Every dependency is listed and justified in docs/wpf-webview2-migration.md ("Dependencies"). -->
  <ItemGroup Label="Build-time analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <!-- DPAPI for the credential vault (spike S7); Microsoft's wrapper instead of hand-marshaling CryptProtectData. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Desktop">
    <!-- The UI host (plan, "Dependencies": exact pin). Spike S2 proves the bridge and lock-down against it. -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="[1.0.4258.31]" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <!-- Spike S8 measures parity with better-sqlite3; the Store port adopts the same engine in P1. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- xunit.v3 runs on Microsoft.Testing.Platform (global.json "test.runner"); no VSTest packages are needed. -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
