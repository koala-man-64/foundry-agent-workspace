<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spikes S3 (tab bounds) and S4 (input ladder): the integrated browser's tab surface on a visible desktop.
       Rudy runs it (docs/spikes); it is never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport's generated marshalling and the native window procedure. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- PerMonitorV2 and asInvoker, as the plan's host manifest (section 3). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pages\*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Foundry.WebView2.Tests" />
  </ItemGroup>
</Project>
